{
  "expo": {
    "name": "Macro",
    "slug": "macro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.macro.app"
    },
    "android": {
      "package": "com.macro.app"
    },
    "plugins": [
      [
        "expo-camera",
        { "cameraPermission": "Allow Macro to access your camera to scan barcodes." }
      ]
    ]
  }
}
