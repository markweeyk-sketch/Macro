{
  "expo": {
    "name": "Macro",
    "slug": "macro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F7F4EE",
    "runtimeVersion": "1.0.0",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/0b4a2d01-d0f3-49f7-b579-7e1e62f42436"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.macro.app"
    },
    "android": {
      "package": "com.macro.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F4EE"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Macro to access your camera to scan barcodes.",
          "recordAudioAndroidPermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EE",
          "dark": {
            "backgroundColor": "#161513"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0b4a2d01-d0f3-49f7-b579-7e1e62f42436"
      }
    },
    "owner": "joseph_sanchez"
  }
}
