{
  "expo": {
    "name": "Macro",
    "slug": "macro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.macro.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F4EE"
      },
      "package": "com.macro.app"
    },
    "plugins": [
      [
        "expo-camera",
        { "cameraPermission": "Allow Macro to access your camera to scan barcodes." }
      ]
    ]
  }
}
