{
  "expo": {
    "name": "Macro",
    "slug": "macro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F7F4EE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.macro.app"
    },
    "android": {
      "package": "com.macro.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F4EE"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Macro to access your camera to scan barcodes."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EE",
          "dark": {
            "backgroundColor": "#161513"
          }
        }
      ]
    ]
  }
}
